# Catalog: sqlite (default, one file) or postgres for larger setups (ADR 0014).
DB_DRIVER=sqlite
DB_DSN=/data/db/memries.db
SESSION_KEY=replace-with-32-byte-random-base64
# First-run password for every ADMIN_EMAILS account (ADR 0016). It only fills an
# empty password, so changing a password later is not undone on restart.
BOOTSTRAP_PASSWORD=password
# Comma-separated emails that may manage indexed folders (Folders tab)
ADMIN_EMAILS=admin@example.com
# Extra container paths local folders may use; mount them as volumes on the backend
SOURCE_ROOTS=
